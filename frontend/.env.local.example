# Career AI frontend environment variables.
# Copy this file to .env.local (gitignored, same pattern as backend/.env) and adjust
# if your backend runs somewhere other than the default.

# The backend's address (stage 99). Read by the Next.js server only: the browser always
# calls this site's /api/..., which is forwarded here, so the login cookie works.
# On Vercel set it to the Render address. (NEXT_PUBLIC_API_BASE_URL is no longer used.)
BACKEND_URL=http://127.0.0.1:8000

# Only on the public demo (e.g. Vercel): shows the "made-up data, reset daily" banner.
# NEXT_PUBLIC_DEMO_MODE=true
