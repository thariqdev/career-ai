# Career AI backend environment variables
DEBUG=false
DATABASE_URL=postgresql+pg8000://user:password@localhost:5432/career_ai

# Optional. Leave empty to safely use the placeholder requirement extractor (no
# network calls, no cost). Set a real key to switch on the real Claude-backed one.
ANTHROPIC_API_KEY=

# Optional, free: a local AI reader through Ollama (https://ollama.com), used together
# with the skill-list matcher to also spot skills you haven't saved yet. Install Ollama,
# run `ollama pull llama3.2`, then set the model name here. Leave empty to turn it off.
# If ANTHROPIC_API_KEY is also set, the paid Claude reader is used instead.
OLLAMA_MODEL=
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional, free: meaning search for the Assistant (RAG stage 66). Run
# `ollama pull nomic-embed-text`, then set this. Leave empty for keyword search only.
OLLAMA_EMBED_MODEL=

# Optional, free: let a local model WRITE the Assistant's answers from your notes (RAG
# stage 67). Run `ollama pull llama3.2`, then set this. Leave empty and the answer is the
# notes themselves. The answer must cite the notes, or the notes are shown instead.
OLLAMA_CHAT_MODEL=

# Optional: how long Ollama keeps the models loaded after each use (default 30m; "-1"
# = always, "0" = unload at once). Loaded models answer in about a second; a cold load
# takes 10+ seconds. While loaded they use about 3.2 GB of memory. With the AI switched
# on, the backend also loads them (and embeds your notes) in the background at startup.
# OLLAMA_KEEP_ALIVE=30m

# --- Hosting (stage 94). Not needed locally. ---------------------------------------
# DATABASE_URL may also be pasted exactly as a host prints it, e.g. Neon's
# postgresql://user:pass@ep-xyz.neon.tech/db?sslmode=require  (it is translated for pg8000).
# Force SSL even without ?sslmode=require in the URL:
# DATABASE_SSL=true
# The websites allowed to call this API, comma-separated (default: localhost:3000).
# CORS_ORIGINS=https://your-site.vercel.app
# The public demo: seeds a made-up career into an empty database, and switches off
# backup import/restore. NEVER set this on your own machine with your real data.
# DEMO_MODE=true
# The secret the daily reset (POST /demo/reset, header X-Demo-Token) must send.
# DEMO_RESET_TOKEN=

# --- AI in production, without Ollama (free hosted tiers). Not needed locally. ---------
# Meaning search with Google's gemini-embedding-2 (768 dims) instead of Ollama:
# EMBED_PROVIDER=gemini
# The writer: Groq first (openai/gpt-oss-20b), Gemini Flash-Lite if Groq fails:
# CHAT_PROVIDER=groq
# Keys stay on the server only. Free tiers may use what you send to improve their
# products, so only use these with data you're happy to share (the demo's made-up data).
# GROQ_API_KEY=
# GEMINI_API_KEY=
# Optional model overrides (defaults shown):
# GEMINI_EMBED_MODEL=gemini-embedding-2
# GROQ_CHAT_MODEL=openai/gpt-oss-20b
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
